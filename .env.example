# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check https://ai.google.dev/gemini-api/docs/live-api for the current live-audio model name.
# This changes over time, verify before deploying.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_EMBED_MODEL=text-embedding-004

PORT=8080

# Comma separated list of domains allowed to embed the widget (CORS + WS origin check).
# Use * only for local testing.
ALLOWED_ORIGINS=*
